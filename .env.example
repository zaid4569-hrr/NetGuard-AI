# NetGuard AI — Environment Configuration

# Fast API Backend
PROJECT_NAME="NetGuard AI"
VERSION="2.0.0"
API_V1_STR="/api"
DATABASE_URL="sqlite+aiosqlite:///./data/netguard.db"

# Auth: comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Auth: JWT signing secret. Leave empty for local dev — a random secret is
# generated automatically and saved to backend/data/.jwt_secret on first run.
# Set this explicitly (e.g. `openssl rand -hex 32`) in any real deployment.
JWT_SECRET_KEY=""
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: only needed if you enable Firebase Authentication (the
# VITE_FIREBASE_* vars below are set on the frontend). This is just your
# Firebase project ID (not a secret) — verification uses Google's public
# certs. Find it in Firebase Console > Project Settings > General.
FIREBASE_PROJECT_ID=""

# Optional: Local / Offline LLM Integration (Ollama / LocalAI / Llama.cpp)
ENABLE_LOCAL_LLM=false
LOCAL_LLM_URL="http://localhost:11434/api/generate"

# Optional: Firebase Authentication (frontend). Leave empty for the
# built-in backend email/password auth instead. Get these from Firebase
# Console > Project Settings > General > Your apps > SDK setup and config.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
